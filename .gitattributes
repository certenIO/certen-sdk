# Every text file is LF in the index and in every checkout. On Windows, autocrlf used to rewrite the working tree to CRLF, which made
# the generated agent artifacts byte-different from what the generator writes (npm run agentgen:check reported them STALE).
* text=auto eol=lf
*.gz binary
*.png binary
*.jpg binary
# The SDK copy of the CERTEN core profiles is pinned byte for byte (packages/sdk/scripts/sync-core.mjs, src/core/PIN.json): no checkout may rewrite it.
packages/sdk/src/core/*.ts -text
packages/sdk/src/core/PIN.json -text
packages/sdk/src/agent/mandate.ts -text
