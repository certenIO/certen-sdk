{
  "name": "@certen.io/proof-verify",
  "version": "0.1.0",
  "description": "Independent verifier for CERTEN proof v2: checks a proof offline against Accumulate's own encodings, with no CERTEN code in the trust path",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node ../../scripts/build-package.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "accumulate-sdk-opendlt": "2.4.0"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "vitest": "^5.0.3",
    "@types/node": "^22.0.0"
  }
}
